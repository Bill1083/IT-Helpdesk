# ---------------------------------------------------------------------------
# IT Desk configuration. Copy to .env and fill in the required values.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# The password for the login screen.
APP_PASSWORD=

# Gemini API key from https://aistudio.google.com/apikey
# Powers the steps, background research and past-problem matching.
GEMINI_API_KEY=

# --- Optional ---------------------------------------------------------------
# Anthropic key from https://console.anthropic.com - enables the
# "Think harder" button, which re-does a step with Claude + web search.
ANTHROPIC_API_KEY=

# Host port. docker-compose.yml publishes the container on 127.0.0.1:${PORT}.
PORT=7891

# How long "Remember me" keeps you signed in. Each visit renews it.
REMEMBER_DAYS=30

# Extra secret mixed into the session signature. Leave blank to derive it
# from APP_PASSWORD (changing the password then signs everyone out).
SESSION_SECRET=

# Nightly off-site backup to a Cloudflare R2 bucket (all four turn it on).
# See "Backups to Cloudflare R2" in DEPLOYMENT.md for where to find these.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Only for buckets created with an EU (or FedRAMP) jurisdiction:
# R2_ENDPOINT=https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
# BACKUP_KEEP_DAYS=30

# Model overrides - the defaults are the fastest sensible choices.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GEMINI_RESEARCH_MODEL=gemini-3.8-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# ANTHROPIC_MODEL=claude-opus-5-5

# How alike two problems must be (0-1) before "This sounds like..." appears.
# SIMILARITY_THRESHOLD=0.72
